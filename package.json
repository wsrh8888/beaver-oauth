{
  "name": "beaver-open",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Beaver Open Platform - 海狸开放平台",
  "scripts": {
    "dev": "vite serve --mode=dev",
    "serve_prod": "vite serve --mode=prod",
    "serve_test": "vite serve --mode=test",
    "build_prod": "vue-tsc -b && vite build --mode=prod",
    "build_test": "vue-tsc -b && vite build --mode=test",
    "lint": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@beaver/js-sdk": "file:../beaver-sdk/packages/beaver-js-sdk",
    "@element-plus/icons-vue": "2.3.1",
    "axios": "1.10.0",
    "element-plus": "2.10.2",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.16.1",
    "@types/crypto-js": "4.2.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.0.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.30.0",
    "husky": "9.1.7",
    "less": "4.3.0",
    "lint-staged": "16.1.2",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": "eslint --fix"
  }
}
